# Copiar a .env.local y completar. NO poner credenciales reales en este archivo: está versionado.

# ---- Base propia (usuarios y sesiones) ----
APP_DATABASE_URL=postgres://naps:CAMBIAR@localhost:5440/naps_ccc

# ---- PostGIS de NAPs (SOLO LECTURA): el servidor GIS real, también en desarrollo (la app nunca escribe ahí) ----
# GIS_HOST y la clave los da sistemas. Rol de solo lectura (GRANT SELECT sobre nap_con_disponibilidad).
# Si el servidor tiene TLS: agregar ?sslmode=require. Copia local para desarrollo con escritura: ver README.
GIS_DATABASE_URL=postgres://naps_ro:CAMBIAR@GIS_HOST:5432/cccqgis
GIS_SCHEMA=public

# ---- Webservice spi40 (sistema de abonados) y herramientas OLT (red interna) ----
SPI40_BASE_URL=http://SPI40_HOST/spi40/abn/webservice.php
SPI40_OPERADOR_WS=1
SPI40_TIMEOUT_MS=8000
SPI40_CACHE_TTL_MS=15000
OLT_BASE_URL=http://OLT_HOST/smi/ftth.tools_box.php
# La OLT tarda entre 7 y 25 s por ONT (medido 2026-09-09): timeout largo, consulta diferida y caché de 5 min
OLT_TIMEOUT_MS=30000
OLT_CONCURRENCIA=8
OLT_MAX_EN_VUELO=16
OLT_CACHE_TTL_MS=300000
OLT_REFRESH_MIN_MS=30000

# ---- Auth (better-auth). Generar el secreto con: openssl rand -base64 32 ----
BETTER_AUTH_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
BETTER_AUTH_URL=http://localhost:3110
AUTH_COOKIE_CACHE_S=60
# Solo para `npm run seed:admin` (crea el primer admin). Borrar una vez creado.
ADMIN_SEED_EMAIL=admin@ccc.local
ADMIN_SEED_PASSWORD=cambiar-esta-clave-123

# ---- Salud (GET /api/health?deep=1). Generar con: openssl rand -hex 32 ----
# HEALTH_TOKEN=
# HEALTH_OLT_MAC=aabbccddeeff

# ---- Reglas de negocio ----
BUSQUEDA_RADIO_DEFAULT_M=500
BUSQUEDA_RADIO_MAX_M=5000
BUSQUEDA_MAX_RESULTADOS=500

# ---- Operación ----
LOG_LEVEL=info
TZ=America/Argentina/Tucuman

# ---- Geocodificador de direcciones (opcional) ----
# Corre en el navegador. Por defecto usa el Nominatim público de OSM (1 consulta/seg, sin clave).
# Si se apunta a otro, debe ser https:// y alcanzable desde los navegadores de los usuarios (no solo desde el servidor).
# NEXT_PUBLIC_GEOCODER_URL=https://nominatim.openstreetmap.org/search
