# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: los .example SÍ se versionan (sin credenciales reales)
.env
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# naps-ccc-nextjs
.env.local
.env.docker
.env.db
/backups
/playwright-report
/test-results
/tests/e2e/.auth
# nginx: certificados de prueba y desafíos ACME (nunca se versionan)
/docker/nginx/certs
/docker/nginx/acme/*
!/docker/nginx/acme/.gitkeep
