# Variables del contenedor `app` (docker compose --profile prod). Copiar a .env.docker y completar.
# NO poner credenciales reales en este archivo: está versionado.
# app-db es el Postgres propio (clave NAPS_APP_PASSWORD de .env.db). GIS_HOST es el servidor PostGIS real, alcanzable por la red del host.
APP_DATABASE_URL=postgres://naps_app:CAMBIAR@app-db:5432/naps_ccc
GIS_DATABASE_URL=postgres://naps_ro:CAMBIAR@GIS_HOST:5432/cccqgis
GIS_SCHEMA=public

SPI40_BASE_URL=http://SPI40_HOST/spi40/abn/webservice.php
SPI40_OPERADOR_WS=1
SPI40_TIMEOUT_MS=8000
SPI40_CACHE_TTL_MS=15000
OLT_BASE_URL=http://OLT_HOST/smi/ftth.tools_box.php
OLT_TIMEOUT_MS=30000
OLT_CONCURRENCIA=8
OLT_MAX_EN_VUELO=16
OLT_CACHE_TTL_MS=300000
OLT_REFRESH_MIN_MS=30000

# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
# URL pública con la que los usuarios abren la app. Debe ser https:// (la termina nginx, ver compose.yml)
BETTER_AUTH_URL=https://naps.example.com
AUTH_COOKIE_CACHE_S=60

# Primer arranque: crea el admin inicial. Después del primer login, BORRAR estas dos líneas y reiniciar el contenedor.
# (Si ya existe el usuario, el seed no toca nada. Para forzar un reset de clave: ADMIN_SEED_FORCE=1 una sola vez.)
ADMIN_SEED_EMAIL=admin@ccc.local
ADMIN_SEED_PASSWORD=cambiar-esta-clave-123

# GET /api/health?deep=1 con `Authorization: Bearer <HEALTH_TOKEN>`. Generar con: openssl rand -hex 32
HEALTH_TOKEN=
# MAC (12 hex) de una ONT conocida para el check de la OLT; si se omite, no se prueba la OLT.
# HEALTH_OLT_MAC=

BUSQUEDA_RADIO_DEFAULT_M=500
BUSQUEDA_RADIO_MAX_M=5000
BUSQUEDA_MAX_RESULTADOS=500

LOG_LEVEL=info
TZ=America/Argentina/Tucuman

# ---- Geocodificador de direcciones (opcional) ----
# Corre en el navegador. Por defecto usa el Nominatim público de OSM (1 consulta/seg, sin clave).
# Si se apunta a otro, debe ser https:// y alcanzable desde los navegadores de los usuarios (no solo desde el servidor).
# NEXT_PUBLIC_GEOCODER_URL=https://nominatim.openstreetmap.org/search
