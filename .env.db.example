# Credenciales del Postgres propio (servicio app-db). Copiar a .env.db. Generar claves con: openssl rand -base64 24
# POSTGRES_*     : superusuario del contenedor (solo administración, backups y el healthcheck).
# NAPS_APP_PASSWORD : rol `naps_app` (dueño de la base, sin superusuario) que usa la app. Misma clave que APP_DATABASE_URL en .env.docker:
#                    APP_DATABASE_URL=postgres://naps_app:<NAPS_APP_PASSWORD>@app-db:5432/naps_ccc
POSTGRES_USER=naps
POSTGRES_PASSWORD=CAMBIAR
POSTGRES_DB=naps_ccc
NAPS_APP_PASSWORD=CAMBIAR
