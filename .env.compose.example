# Variables de compose.yml. Copiar a .env (junto a compose.yml) y completar.

# Hostname público con el que entran los usuarios (debe coincidir con BETTER_AUTH_URL de .env.docker y con el certificado).
PUBLIC_HOST=nap.viaccc.com

# Qué servicios levantar:
#   prod       : app + app-db. La app queda en APP_BIND:APP_PORT y el proxy HTTPS del host (Apache) reenvía ahí.
#                Es lo que se entrega a IT (ver ENTREGA.md).
#   prod,nginx : además un nginx propio como frente HTTPS en 80/443 (solo para un host sin otro servidor web; ver README).
COMPOSE_PROFILES=prod

# Puerto que se entrega a IT. APP_BIND=127.0.0.1 si el proxy está en el mismo servidor (caso lab-CCC-NAPs);
# la IP de LAN del servidor solo si el proxy está en otra máquina. Nunca 0.0.0.0.
APP_PORT=3110
# APP_BIND=127.0.0.1

# Solo con el perfil nginx:
# TLS_DIR=/etc/letsencrypt     (live/<PUBLIC_HOST>/{fullchain,privkey}.pem, formato certbot; lo mantiene IT)
# HTTP_PORT=80
# HTTPS_PORT=443

# APP_TAG=  (lo fija docker/deploy.sh con el sha de git)
