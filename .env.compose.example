# Variables de compose.yml. Copiar a .env (junto a compose.yml) y completar.

# Hostname público con el que entran los usuarios (debe coincidir con BETTER_AUTH_URL de .env.docker y con el certificado).
PUBLIC_HOST=naps.example.com

# Qué servicios levantar:
#   prod,nginx : app + app-db + nginx como frente HTTPS en HTTP_PORT/HTTPS_PORT (el host no tiene otro servidor web).
#   prod       : solo app + app-db; el Apache/otro proxy del host reenvía a 127.0.0.1:APP_PORT
#                (servidor del legacy: ver docker/apache/naps-ccc.conf.example).
COMPOSE_PROFILES=prod,nginx

# Puerto de la app en el loopback del host (lo usa el proxy del host y el smoke test de deploy.sh).
APP_PORT=3110

# Solo con el perfil nginx:
# Carpeta con live/<PUBLIC_HOST>/{fullchain,privkey}.pem, formato certbot. La mantiene IT. Default: /etc/letsencrypt.
# TLS_DIR=/etc/letsencrypt
# Puertos publicados por nginx (cambiar solo si 80/443 están ocupados y hay un NAT delante).
# HTTP_PORT=80
# HTTPS_PORT=443

# APP_TAG=  (lo fija docker/deploy.sh con el sha de git)
